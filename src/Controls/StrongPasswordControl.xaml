<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MopsterTeams.Controls.StrongPasswordControl"
    x:Name="_this">

    <Grid BindingContext="{Reference _this}" ColumnSpacing="3">
        <BoxView x:Name="level_1" Grid.Column="0" HeightRequest="2" StyleId="0" BackgroundColor="{Binding StrongPassword, Converter={StaticResource StrongPasswordConverter}, ConverterParameter={Reference level_1}}" VerticalOptions="Start"/>
        <BoxView x:Name="level_2" Grid.Column="1" HeightRequest="2" StyleId="1" BackgroundColor="{Binding StrongPassword, Converter={StaticResource StrongPasswordConverter}, ConverterParameter={Reference level_2}}" VerticalOptions="Start"/>
        <BoxView x:Name="level_3" Grid.Column="2" HeightRequest="2" StyleId="2" BackgroundColor="{Binding StrongPassword, Converter={StaticResource StrongPasswordConverter}, ConverterParameter={Reference level_3}}" VerticalOptions="Start"/>
        <BoxView x:Name="level_4" Grid.Column="3" HeightRequest="2" StyleId="3" BackgroundColor="{Binding StrongPassword, Converter={StaticResource StrongPasswordConverter}, ConverterParameter={Reference level_4}}" VerticalOptions="Start"/>
    </Grid>
</ContentView>
