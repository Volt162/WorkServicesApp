<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MopsterTeams.Controls.ScaleButton"
    x:Name="_this">

    <Grid BindingContext="{Reference _this}" HeightRequest="40" TouchEffect.PressedScale="0.95" TouchEffect.AnimationDuration="100">
        <Frame x:Name="bg" BackgroundColor="{Binding BackgroundColor}" CornerRadius="4" HasShadow="False"/>
        <HorizontalStackLayout Padding="5,0" HorizontalOptions="Center" Spacing="6">
            <Image x:Name="icon" Source="{Binding Source}" IsVisible="False" HorizontalOptions="EndAndExpand" HeightRequest="15"/>
            <Label x:Name="label" VerticalOptions="Center" HorizontalOptions="FillAndExpand"
                   LineBreakMode="TailTruncation"
                   VerticalTextAlignment="Center"
                   HorizontalTextAlignment="Center"
                   Text="{Binding Text}"
                   TextColor="{Binding TextColor}"
                   FontSize="{StaticResource BaseFontSize}"
                   FontFamily="{StaticResource OpenSansSemiBold}"/>
        </HorizontalStackLayout>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command}"/>
        </Grid.GestureRecognizers>
    </Grid>

</ContentView>
